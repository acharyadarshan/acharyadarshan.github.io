---
layout: base.njk
extraScripts: '<script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>'
---

<div class="container pt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-3">
                <a href="/paper_summaries/">&larr; All paper summaries</a>
            </div>
            <h2>{{ title }}</h2>
            <p class="text-muted" style="font-size:0.9em;">Week: {{ week }}</p>
            <div class="content">
                {{ content | safe }}
            </div>
        </div>
    </div>
</div>
